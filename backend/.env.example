# Use PostgreSQL for hosted production. SQLite is used locally when DATABASE_URL is omitted.
DATABASE_URL=sqlite:///./codex.db
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_EXPIRE_MINUTES=10080
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Judge0 CE / compatible endpoint. Do not expose keys to the frontend.
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_TIMEOUT_SECONDS=15
# Bootstrap admin is created only when both values are configured. Change the password after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
